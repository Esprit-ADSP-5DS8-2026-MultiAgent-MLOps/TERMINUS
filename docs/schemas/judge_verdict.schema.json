{
  "$defs": {
    "Criterion": {
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "grounded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounded"
        },
        "name": {
          "enum": [
            "correctness",
            "completeness",
            "regression_risk",
            "evidence_quality",
            "scope_compliance"
          ],
          "title": "Name",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "CONCERN",
            "FAIL"
          ],
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "name",
        "result",
        "rationale"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Failure": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/FailureKind"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FailureKind": {
      "enum": [
        "LLM_ERROR",
        "QUOTA",
        "TIMEOUT",
        "BUDGET_EXCEEDED",
        "MAX_STEPS",
        "NO_TOOL_USE",
        "INVALID_SUBMISSION",
        "INPUT_INVALID",
        "INTERNAL"
      ],
      "title": "FailureKind",
      "type": "string"
    },
    "LineageRef": {
      "properties": {
        "project_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Hash"
        },
        "report_id": {
          "title": "Report Id",
          "type": "string"
        },
        "report_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Sha256"
        },
        "report_type": {
          "enum": [
            "validator",
            "repair",
            "judge"
          ],
          "title": "Report Type",
          "type": "string"
        }
      },
      "required": [
        "report_type",
        "report_id"
      ],
      "title": "LineageRef",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "OK",
        "FAILED_CLOSED"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "description": "Verdict sur UNE réparation. Aucune décision d'admission : c'est le rôle exclusif du Validator + moteur de politique.",
  "properties": {
    "created_at": {
      "default": "",
      "title": "Created At",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "evidence_examined": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Examined",
      "type": "array"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "independent_model": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Independent Model"
    },
    "judge_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judge Model"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/LineageRef"
      },
      "title": "Lineage",
      "type": "array"
    },
    "llm": {
      "additionalProperties": true,
      "title": "Llm",
      "type": "object"
    },
    "next_action": {
      "enum": [
        "REVALIDATE",
        "RETRY",
        "ESCALATE",
        "ROLLBACK"
      ],
      "title": "Next Action",
      "type": "string"
    },
    "overridden_by_invariant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overridden By Invariant"
    },
    "project": {
      "default": "",
      "title": "Project",
      "type": "string"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "remaining_concerns": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Concerns",
      "type": "array"
    },
    "repair_id": {
      "title": "Repair Id",
      "type": "string"
    },
    "repair_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repair Model"
    },
    "report_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Sha256"
    },
    "report_type": {
      "const": "judge",
      "default": "judge",
      "title": "Report Type",
      "type": "string"
    },
    "run_status": {
      "$ref": "#/$defs/RunStatus",
      "default": "OK"
    },
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "ACCEPT",
        "REVISE",
        "REJECT"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "verdict_id": {
      "default": "",
      "title": "Verdict Id",
      "type": "string"
    }
  },
  "required": [
    "repair_id",
    "verdict",
    "next_action"
  ],
  "title": "JudgeVerdict",
  "type": "object"
}
