# Agent 3 (API + Docker). Copier en agents/agent3/.env et remplir avec SES valeurs. Ne jamais commiter .env.
# Tout est facultatif : sans ce fichier, l'API est générée, testée et déployée en local, sans publication.

# Publication sur Docker Hub, après l'approbation « mise en production » (1 = activée)
AGENT3_PUSH=
DOCKERHUB_USERNAME=
# Jeton d'accès : hub.docker.com > Account settings > Personal access tokens (Read & Write)
DOCKERHUB_TOKEN=
# Organisation Docker Hub (vide = le compte ci-dessus). Un dépôt créé par un push est public.
DOCKER_IMAGE_NAMESPACE=

# Port de l'API déployée (8000 par défaut)
# AGENT3_PORT=8000

# Corrections par LLM quand un test de l'API échoue (facultatif, AGENT3_NO_FIX=1 pour les couper)
# LLM_PROVIDER : openai | groq | gemini | ollama. Le modèle doit gérer les appels d'outils.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY_DOCKER=
