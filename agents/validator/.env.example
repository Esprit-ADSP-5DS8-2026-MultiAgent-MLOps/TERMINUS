# Validateur v2, Repair et Judge (Sarra). Copier en agents/validator/.env et remplir avec SA clé.
# Appliqué seulement pendant le nœud « repair » de l'orchestrateur (common/envscope.py), puis retiré.

# LLM principal (Groq)
GROQ_API_KEY=

# Modèles par agent (vides = défauts de agentic_core/llm_client.py :
#   validator, repair : openai/gpt-oss-120b ; judge : qwen/qwen3.8-27b, une autre famille que le Repair)
GROQ_MODEL_VALIDATOR=
GROQ_MODEL_REPAIR=
GROQ_MODEL_JUDGE=
# low | medium | high | none
GROQ_REASONING_EFFORT_VALIDATOR=
GROQ_REASONING_EFFORT_REPAIR=
GROQ_REASONING_EFFORT_JUDGE=
# Plafond de tokens par minute de votre compte Groq (évite les 429)
GROQ_TPM_LIMIT=

# Secours facultatifs si Groq échoue (quota, panne) : n = 1..3, provider groq | openai | gemini | ollama
FALLBACK_1_PROVIDER=
FALLBACK_1_MODEL=
FALLBACK_1_API_KEY=
FALLBACK_1_BASE_URL=
# Ordre d'essai : groq et les numéros des secours, ex. groq,1
LLM_ORDER=

# Exécution du projet pendant le diagnostic et la réparation
# venv (défaut : venv dédié construit depuis requirements.txt, cache ~/.cache/contract-validator) | current
REPAIR_ENV=
# auto (défaut : Docker si disponible) | docker | subprocess
REPAIR_SANDBOX=
