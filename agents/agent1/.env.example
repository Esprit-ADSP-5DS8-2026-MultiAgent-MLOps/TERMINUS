# Groq provider for docstring/type-hint edits and optional ML fixes
GROQ_API_KEY=
AGENT1_LLM_API_KEY=
AGENT1_LLM_MODEL=openai/gpt-oss-20b
AGENT1_LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT1_LLM_TIMEOUT=120
AGENT1_ENABLE_LLM=true

# Optional ML-fix provider overrides
XAI_API_KEY=
ML_LLM_API_KEY=
ML_LLM_MODEL=openai/gpt-oss-120b
ML_LLM_BASE_URL=https://api.groq.com/openai/v1
ML_LLM_MAX_TOKENS=4000
ML_LLM_REASONING_EFFORT=
