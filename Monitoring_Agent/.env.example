# Copier en Monitoring_Agent/.env puis remplir. Ne jamais commiter .env.

# Décideur et enquêteur : Groq
GROQ_API_KEY=

# Juge, autre famille de modèle : Gemini
GEMINI_API_KEY=


MONITORING_DECIDER=groq:openai/gpt-oss-120b
# Le Qwen fine-tuné hébergé sur Hugging Face :
# MONITORING_DECIDER=hf:agent4
# MONITORING_HF_BASE_URL=https://<utilisateur>-<space>.hf.space/v1
# MONITORING_HF_TIMEOUT_S=300
# HF_TOKEN=
# Sur Mac avec le Qwen fine-tuné (mlx_lm.server sur :8080) :
# MONITORING_DECIDER=mlx:default_model
MONITORING_DECIDER_FALLBACK=groq:openai/gpt-oss-120b
MONITORING_INVESTIGATOR=groq:openai/gpt-oss-120b
MONITORING_JUDGE=gemini:gemini-3.8-flash
MONITORING_REASONING_EFFORT=medium

# Langfuse (optionnel)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# App Slack (optionnel, voir infra/slack/manifest.yml)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
SLACK_APPROVERS=