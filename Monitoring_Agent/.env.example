# Copier ce fichier en Monitoring_Agent/.env puis remplir. Ne jamais commiter .env (il est ignoré par git).

# Clés LLM (gratuites)
# Groq : https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (le juge) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèles (optionnel, valeurs par défaut dans agent/llm.py). Format fournisseur:modèle.
# Liste des modèles disponibles : python -m monitoring_agent llm-check
# MONITORING_DECIDER=groq:openai/gpt-oss-120b
# MONITORING_DECIDER_FALLBACK=groq:qwen/qwen3.8-27b
# MONITORING_JUDGE=gemini:gemini-3.8-flash
# MONITORING_JUDGE_TIMEOUT_S=60               # au-delà, la règle R7 passe au second avis des règles
# MONITORING_REASONING_EFFORT=medium          # gpt-oss : low | medium | high

# Diagnostiqueur local fine-tuné (mlx_lm.server sur :8080, ou Ollama). L'enquête reste à un grand modèle.
# MONITORING_DECIDER=mlx:default_model
# MONITORING_INVESTIGATOR=groq:openai/gpt-oss-120b
# Modèle du chat « Demande à ton monitoring » (par défaut : l'enquêteur)
# MONITORING_ASSISTANT=groq:openai/gpt-oss-120b
# Professeurs pour la distillation (finetune teach)
# MONITORING_TEACHERS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b

# Notifications : webhook Slack, Teams, Discord ou Mattermost (sinon seulement notifications.jsonl)
# MONITORING_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
# Adresse de la console mise dans les messages (lien direct vers la décision)
# MONITORING_PUBLIC_URL=http://127.0.0.1:8100

# Mémoire d'incidents (RAG) : modèle d'embedding (multilingue, environ 220 Mo) ; « hash » = hors ligne
# MONITORING_EMBEDDER=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# MONITORING_MEMORY=0                         # désactiver la mémoire

# Langfuse (optionnel) : https://cloud.langfuse.com > Settings > API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
