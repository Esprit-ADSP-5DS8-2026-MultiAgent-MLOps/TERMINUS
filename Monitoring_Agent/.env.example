# Copier en Monitoring_Agent/.env et remplir. Ne JAMAIS commiter .env (ignoré par git).
# Décideur (diagnostic + décision) : Groq, gratuit — https://console.groq.com/keys
GROQ_API_KEY=
# Juge (autre famille de modèle) : Gemini, gratuit — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèles (optionnel ; défauts dans agent/llm.py). Format fournisseur:modèle — liste : python -m monitoring_agent llm-check
# MONITORING_DECIDER=groq:openai/gpt-oss-120b
# MONITORING_DECIDER_FALLBACK=groq:qwen/qwen3.8-27b
# MONITORING_JUDGE=gemini:gemini-3.8-flash
# MONITORING_REASONING_EFFORT=medium        # gpt-oss : low | medium | high

# Diagnostiqueur local fine-tuné (mlx_lm.server sur :8080) ; l'enquête reste à un grand modèle
# MONITORING_DECIDER=mlx:default_model
# MONITORING_INVESTIGATOR=groq:openai/gpt-oss-120b
# Professeurs pour la distillation (finetune teach)
# MONITORING_TEACHERS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b

# Mémoire d'incidents (RAG) : modèle d'embedding (défaut multilingue, ~220 Mo) ; « hash » = hors ligne
# MONITORING_EMBEDDER=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# MONITORING_MEMORY=0                        # désactiver la mémoire

# LLMOps (optionnel) : https://cloud.langfuse.com > Settings > API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
