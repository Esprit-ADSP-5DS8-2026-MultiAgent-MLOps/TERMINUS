# .env commun de la plateforme. Copier en .env à la racine (jamais commité), puis le charger :
#   set -a; source .env; set +a
# Chaque membre met ses propres clés : les quotas gratuits ne tiennent pas avec une seule clé partagée.

# ---------------------------------------------------------------------------
# Orchestrateur
# ---------------------------------------------------------------------------
# Superviseur Gemini : clé personnelle créée sur Google AI Studio
GEMINI_API_KEY=
ORCH_GEMINI_MODEL=gemini-2.5-flash
# Agents utilisés : real (défaut : vrais agents intégrés, stubs pour les autres) | stub | liste (ex. agent4)
# ORCH_AGENTS=real
# Sauvegarde des runs dans PostgreSQL (docker compose -f infra/docker-compose.yml up -d)
# Laisser commenté pour utiliser SQLite (runs/checkpoints.sqlite), sans rien installer.
# ORCH_DATABASE_URL=postgresql://mlops:mlops@localhost:5432/orchestrator

# ---------------------------------------------------------------------------
# Agent 4 : monitoring (détail : agents/agent4/.env.example)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
MONITORING_DECIDER=groq:openai/gpt-oss-120b
MONITORING_DECIDER_FALLBACK=groq:openai/gpt-oss-120b
MONITORING_INVESTIGATOR=groq:openai/gpt-oss-120b
MONITORING_JUDGE=gemini:gemini-3.8-flash
MONITORING_REASONING_EFFORT=medium

# Agents 1, 2, 3 et validateur v2 : sections ajoutées à leur intégration (docs/integration.md)
