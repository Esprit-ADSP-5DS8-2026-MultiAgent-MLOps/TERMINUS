      "fastapi",
      "uvicorn[standard]",
      "pydantic"
    ],
    "os_packages": []
  },
  "ml": {
    "framework": "sklearn",
    "framework_version": "1.8.0",
    "model_type": "Pipeline(StandardScaler -> Ridge)",
    "model_file": "model/regressor.joblib",
    "model_exists_in_project": true,
    "model_generation": {
      "required_before_serving": false,
      "command": "python scripts/retrain.py",
      "requires_files": [],
