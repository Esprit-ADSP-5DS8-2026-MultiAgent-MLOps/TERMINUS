{
  "schema_version": "1.0",
  "project_name": "diabetes-progression",
  "needs_user_input": false,
  "python": {
    "version": "3.12",
    "package_manager": "pip",
    "note": "Layout src/ : PYTHONPATH=src requis pour importer dp_model. Verifie sur Python 3.12."
  },
  "dependencies": {
    "file": "requirements.txt",
    "status": "reliable",
    "packages": [
      {
        "name": "scikit-learn",
        "version": "1.8.0"
      },
      {
        "name": "pandas",
        "version": "3.0.2"
      },
      {
        "name": "numpy",
        "version": "2.4.4"
      },
      {
        "name": "joblib",
        "version": "1.5.3"
      }
    ],
    "missing_imports": [],
