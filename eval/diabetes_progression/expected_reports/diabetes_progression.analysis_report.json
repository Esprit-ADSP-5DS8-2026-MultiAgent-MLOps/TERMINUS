    "custom_classes_module": null,
    "other_artifacts": [
      {
        "path": "model/features.json",
        "role": "feature_order"
      }
    ]
  },
  "inference": {
    "entrypoint": {
      "file": "src/dp_model/service.py",
      "import_path": "dp_model.service",
      "function": "score",
      "signature": "score(artifact, rows) -> list[float]",
      "loader_function": "load_artifact(model_dir)",
      "is_async": false,
      "accepts": [
        "dict",
        "list[dict]"
      ]
    },
    "pythonpath": [
      "src"
    ],
    "supports_proba": false,
    "preprocessing_location": "inside_model"
  },
